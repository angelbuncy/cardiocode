# ─── CardioCode Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.

# ── Firebase ──────────────────────────────────────────────────────
# Path to the service account JSON you download from Firebase Console
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=D:\PROJECTS\Cardiocode\backend\firebase-credentials.json

# ── JWT ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── ML Model ──────────────────────────────────────────────────────
# Populated automatically after you run the training script
MODEL_PATH=app/ml_models/cardiocode_rf_model.pkl

# ── Notifications (optional) ──────────────────────────────────────
# TWILIO_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your_auth_token
# TWILIO_FROM=+1234567890
# SENDGRID_API_KEY=SG.xxxxxx
# FROM_EMAIL=no-reply@cardiocode.app
